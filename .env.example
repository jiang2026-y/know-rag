# MinIO endpoint must not include http:// or https://.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=know-engine
MINIO_SECURE=false
# Private objects are served through short-lived presigned URLs.
MINIO_PRESIGNED_URL_EXPIRY_SECONDS=900

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=know_engine
MYSQL_USER=know_engine
# Do not commit the real password.
MYSQL_PASSWORD=
MYSQL_CONNECT_TIMEOUT_SECONDS=5

# Neo4j 图查询仅使用只读应用账号；管理员密码和真实账号只保存在本地 .env。
NEO4J_ENABLED=false
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j
NEO4J_USER=llmcopy_reader
NEO4J_PASSWORD=
# Docker 启动必填，格式固定为 neo4j/管理员强密码；不要提交真实值。
NEO4J_AUTH=
NEO4J_CONNECT_TIMEOUT_SECONDS=5

# 密码哈希：新密码使用 Argon2id；PBKDF2 仅用于兼容成功登录后的自动升级。
AUTH_PASSWORD_HASH_ITERATIONS=600000
AUTH_ARGON2_MEMORY_COST_KIB=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1

# HR 内部开户接口：仅服务端使用，留空时接口保持不可用。
INTERNAL_HR_SERVICE_TOKEN=
INTERNAL_HR_SERVICE_NAME=hr-system

# 雪花分段 ID：同一时刻运行的每个服务实例必须分配不同的 0-1023 值。
SNOWFLAKE_WORKER_ID=0

# Redis distributed locks. The Docker Redis instance requires its configured password.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DATABASE=0
REDIS_CONNECT_TIMEOUT_SECONDS=5
REDIS_LOCK_LEASE_SECONDS=30

# 可靠异步任务使用独立的 Redis 实例（Docker 默认映射到本机 6380），
# 由 Celery 5.4+ 和 Relier 0.1 驱动；请只在本地 .env 写入真实密码。
TASK_REDIS_URL=redis://:123456@127.0.0.1:6380/0
TASK_REDIS_PASSWORD=123456
TASK_MAX_AUTO_RETRIES=3
TASK_DLQ_RETENTION_DAYS=7
RELIER_ENV=development
RELIER_SECRET_KEY=replace-with-a-random-task-runtime-secret
# 省略时由 TASK_REDIS_URL 与 TASK_REDIS_PASSWORD 注入；仅在需覆盖时填写。
RELIER_REDIS_URL=redis://:123456@127.0.0.1:6380/0
RELIER_REDIS_PASSWORD=123456
RELIER_REDIS_USE_SENTINEL=false
RELIER_CELERY_WORKER_COUNT=1
RELIER_CELERY_WORKER_CONCURRENCY=1
RELIER_SOFT_TIMEOUT=900
RELIER_HARD_TIMEOUT=1200
RELIER_GRACEFUL_SHUTDOWN_TIMEOUT=30
RELIER_IDEMPOTENCY_INFLIGHT_TTL=1210
RELIER_MAX_RESURRECTIONS=3
RELIER_HEARTBEAT_TTL=30
RELIER_RESURRECTION_CHECK_INTERVAL=5
RELIER_OTEL_ENABLED=false

# Local Elasticsearch vector store. Keep this version/dimension aligned with the
# DashScope embedding model configuration below.
ELASTICSEARCH_HOST=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=know-engine
ELASTICSEARCH_CONNECT_TIMEOUT_SECONDS=5
ELASTICSEARCH_RESPONSE_TIMEOUT_SECONDS=30

# DashScope OpenAI-compatible embedding API. Keep the real API key in .env only.
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_MAX_SEGMENTS_PER_BATCH=9
EMBEDDING_CONNECT_TIMEOUT_SECONDS=15
EMBEDDING_RESPONSE_TIMEOUT_SECONDS=60

# Chat title generation reuses EMBEDDING_BASE_URL and EMBEDDING_API_KEY above.
CHAT_TITLE_MODEL_NAME=qwen3.5-flash
CHAT_TITLE_MAX_LENGTH=20
CHAT_TITLE_CONNECT_TIMEOUT_SECONDS=5
CHAT_TITLE_RESPONSE_TIMEOUT_SECONDS=20

# 意图识别复用 DashScope 地址和密钥；失败会重试一次，再安全降级为通用对话。
CHAT_INTENT_MODEL_NAME=qwen3.5-flash
CHAT_INTENT_CONNECT_TIMEOUT_SECONDS=5
CHAT_INTENT_RESPONSE_TIMEOUT_SECONDS=20
CHAT_INTENT_MAX_COMPLETION_TOKENS=256

# 汽车相关问题的查询改写；失败时使用原查询继续检索。
CHAT_QUERY_REWRITE_MODEL_NAME=qwen3.5-flash
CHAT_QUERY_REWRITE_CONNECT_TIMEOUT_SECONDS=5
CHAT_QUERY_REWRITE_RESPONSE_TIMEOUT_SECONDS=20
CHAT_QUERY_REWRITE_MAX_COMPLETION_TOKENS=256

# 查询路由使用 qwen3.5-flash，只允许返回 relational_db、graph_db、knowledge_base 三种单一策略。
CHAT_QUERY_ROUTER_MODEL_NAME=qwen3.5-flash
CHAT_QUERY_ROUTER_CONNECT_TIMEOUT_SECONDS=5
CHAT_QUERY_ROUTER_RESPONSE_TIMEOUT_SECONDS=20
CHAT_QUERY_ROUTER_MAX_COMPLETION_TOKENS=256

# 主回答与 SSE：同一用户同时只允许一条活动流，由 Redis 分布式锁保证。
CHAT_ANSWER_MODEL_NAME=qwen3.7-plus
CHAT_ANSWER_CONNECT_TIMEOUT_SECONDS=10
CHAT_ANSWER_RESPONSE_TIMEOUT_SECONDS=120
CHAT_ANSWER_MAX_COMPLETION_TOKENS=1024
CHAT_SSE_HEARTBEAT_SECONDS=15
# 混合召回：向量与全文均先按服务端权限过滤，再用 RRF 融合。
CHAT_RAG_TOP_K=5
CHAT_RAG_VECTOR_TOP_K=20
CHAT_RAG_FULL_TEXT_TOP_K=20
CHAT_RAG_RRF_K=60
CHAT_RAG_CONTEXT_MAX_CHARACTERS=12000

# 多轮记忆：只读取已成功持久化的最近若干条消息，读取失败时降级为无历史。
CHAT_HISTORY_MAX_MESSAGES=10
CHAT_HISTORY_MAX_CHARACTERS=4000

# 父块正文二级缓存：复用上方认证 Session 的 Redis 实例，TTL 到期或文档变更后失效。
SEGMENT_CACHE_ENABLED=true
SEGMENT_CACHE_TTL_SECONDS=30

# DashScope qwen3-rerank 使用工作空间兼容 API；未配置地址时安全降级为 RRF 前五条。
# 例如：https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-api/v1
CHAT_RERANK_BASE_URL=
# 留空时复用 EMBEDDING_API_KEY；如需独立配额可单独填写。
CHAT_RERANK_API_KEY=
CHAT_RERANK_MODEL_NAME=qwen3-rerank
CHAT_RERANK_CONNECT_TIMEOUT_SECONDS=5
CHAT_RERANK_RESPONSE_TIMEOUT_SECONDS=30
CHAT_RERANK_TOP_K=5
CHAT_RERANK_DOCUMENT_MAX_CHARACTERS=4000

# RAGAS 仅用于离线脱敏评测，复用上方百炼连接；不要将真实线上对话或敏感车辆数据提交给评审模型。
RAGAS_EVALUATOR_MODEL_NAME=deepseek-v4-flash-0731
RAGAS_EVALUATOR_CONNECT_TIMEOUT_SECONDS=10
RAGAS_EVALUATOR_RESPONSE_TIMEOUT_SECONDS=120
RAGAS_EVALUATOR_MAX_CONCURRENCY=2

# MinerU Precision Extract API. Create the token at https://mineru.net/apiManage/token.
# Do not commit the real token.
MINERU_API_BASE_URL=https://mineru.net
MINERU_API_TOKEN=
MINERU_MODEL_VERSION=pipeline
MINERU_CONNECT_TIMEOUT_SECONDS=30
MINERU_RESPONSE_TIMEOUT_SECONDS=300
MINERU_TASK_POLL_INTERVAL_SECONDS=2
MINERU_TASK_TIMEOUT_SECONDS=900
MINERU_RESULT_DOWNLOAD_RETRY_ATTEMPTS=7
MINERU_RESULT_DOWNLOAD_RETRY_DELAY_SECONDS=5
MAX_UPLOAD_SIZE_BYTES=104857600
